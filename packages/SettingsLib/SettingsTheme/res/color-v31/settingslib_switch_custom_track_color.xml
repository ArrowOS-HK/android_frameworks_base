<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled and checked: dimmed accent -->
    <item android:state_enabled="false" android:state_checked="true"
          android:color="@color/settingslib_track_on_color"
          android:alpha="?android:attr/disabledAlpha" />
    <!-- Disabled: dimmed off track -->
    <item android:state_enabled="false"
          android:color="@color/settingslib_custom_switch_track_off"
          android:alpha="?android:attr/disabledAlpha" />
    <!-- Checked: accent -->
    <item android:state_checked="true"
          android:color="@color/settingslib_track_on_color" />
    <!-- Default (off) -->
    <item android:color="@color/settingslib_custom_switch_track_off" />
</selector>
