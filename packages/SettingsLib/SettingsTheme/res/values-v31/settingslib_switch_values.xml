<resources>
    <dimen name="settingslib_switch_track_width">44dp</dimen>
    <dimen name="settingslib_switch_track_height">24dp</dimen>
    <dimen name="settingslib_switch_track_radius">12dp</dimen>
    <dimen name="settingslib_switch_thumb_size">18dp</dimen>
    <dimen name="settingslib_switch_thumb_margin">3dp</dimen>

    <!-- Off track: light grey in light mode -->
    <color name="settingslib_custom_switch_track_off">#FFD6D6D6</color>

    <!-- Thumb stays white, slightly transparent when disabled -->
    <color name="settingslib_custom_switch_thumb">#FFFFFFFF</color>
    <color name="settingslib_custom_switch_thumb_disabled">#B3FFFFFF</color>

    <!-- Drop shadow under the thumb -->
    <color name="settingslib_switch_thumb_shadow">#14000000</color>
</resources>
